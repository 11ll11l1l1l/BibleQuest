{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src/v6/**/*.ts",
    "src/v6/**/*.tsx",
    "src/v6/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-v6"
  ]
}
